{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DDYJ",
  "version": "0.1.0",
  "identifier": "com.ddyj.earthquake",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DDYJ 地动预警",
        "width": 375,
        "height": 812,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
